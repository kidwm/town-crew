{
  "name": "town-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/missions/road-repair/domain/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "check": "npm test && npm run build",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler versions upload",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=24"
  }
}
